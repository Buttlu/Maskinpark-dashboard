<div class="container w-100">
    <div class="row">
        <div class="col-4"><span class="text-center">Name</span></div>
        <div class="col-2"><span class="text-center">Status</span></div>
        <div class="col-2"><span class="text-center">Last Data</span></div>
        <div class="col-2"><span class="text-center">Last Updated</span></div>
        <div class="col-2"><span class="text-center">Actions</span></div>
    </div>
    <div class="row">
        @if (Machines.Count > 0) {
            @foreach (var machine in Machines) {
                <MachineTableRow @key="machine.Id"
                                 Machine="machine"
                                 OnRemove="OnRemove"
                                 OnToggleStatus="OnToggleStatus"
                                 OnUpdateData="OnUpdateData" />
            }
        } else {
            <div>Nothing Machines to Display</div>
        }
    </div>
</div>

@code {
    [Parameter]
    public List<MachineDto> Machines { get; set; } = [];

    [Parameter]
    public EventCallback<Guid> OnRemove { get; set; }
    [Parameter]
    public EventCallback<Guid> OnToggleStatus { get; set; }
    [Parameter]
    public EventCallback<UpdateMachineDataDto> OnUpdateData { get; set; }
}
